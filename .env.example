# ==========================================
# DATABASE (PostgreSQL / Neon)
# ==========================================
# Local Docker Postgres URL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/charity_ledger?schema=public"
# Neon Cloud Postgres URL (pooled):
# DATABASE_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# AUTH (Auth.js / NextAuth)
# ==========================================
AUTH_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_KEY_32_BYTES"
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# ENCRYPTION LEVEL 2 (AES-256-GCM - node:crypto)
# ==========================================
# 32-byte (256-bit) hexadecimal key for off-chain private data encryption
AES_256_GCM_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ==========================================
# BLOCKCHAIN & CONTRACTS (Sepolia + viem)
# ==========================================
SEPOLIA_RPC_URL="https://rpc.sepolia.org"
DEPLOYER_PRIVATE_KEY=""
ETHERSCAN_API_KEY=""
NEXT_PUBLIC_CHARITY_LEDGER_CONTRACT_ADDRESS=""

# ==========================================
# VIETQR CONFIGURATION
# ==========================================
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""
VIETQR_TEMPLATE="compact2"

# ==========================================
# WEBHOOK CONFIGURATION
# ==========================================
WEBHOOK_SECRET="local-dev-webhook-secret"


